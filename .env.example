# Farkle Game Environment Variables

# Tolgee Translation API
VITE_TOLGEE_API_URL=http://localhost:4000
VITE_TOLGEE_API_KEY=your-tolgee-api-key

# Development server
VITE_DEV_SERVER_PORT=5173

# Production server
PORT=3000
NODE_ENV=development

# Tolgee Server (for self-hosting)
TOLGEE_SECRET=your-secret-key-for-tolgee-server
