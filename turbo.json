{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "changeset": {
      "dependsOn": [],
      "outputs": [".changeset/**"]
    },
    "changeset-publish": {
      "dependsOn": ["changeset"]
    },
    "release": {
      "dependsOn": ["changeset-publish"],
      "outputs": []
    }
  }
}
