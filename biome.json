{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedImports": "error",
        "noUnusedParameters": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error",
        "noEmptyCatchClause": "error"
      },
      "style": {
        "useNamingConvention": "error",
        "useSelfClosingElements": "error"
      },
      "nursery": {
        "noUnnecessaryTemplateExpression": "error",
        "noUnnecessaryTypeArguments": "error",
        "noUnnecessaryTypeAssertion": "error",
        "noUnnecessaryTypeParameter": "error"
      }
    },
    "include": ["**/*.{js,jsx,ts,tsx,json,jsonc}"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "quoteStyle": "double",
    "semiColons": "always",
    "singleAttributePerLine": false,
    "trailingCommas": "es5",
    "arrowParentheses": "always",
    "files": {
      "include": ["**/*.{js,jsx,ts,tsx,json,jsonc,css,scss,less,html}"]
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semiColons": "always",
      "trailingCommas": "es5"
    }
  },
  "typescript": {
    "formatter": {
      "quoteStyle": "double",
      "semiColons": "always",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "files": {
    "include": ["**/*.{js,jsx,ts,tsx,json,jsonc}"]
  }
}
