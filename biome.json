{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,ts,tsx,json,jsonc}",
      "!**/dist",
      "!**/build",
      "!**/node_modules",
      "!**/prisma",
      "!**/.turbo",
      "!**/*.d.ts",
      "!**/meta.json"
    ],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "bracketSpacing": true
  },
  "linter": {
    "enabled": true,
    "includes": ["**/*.{js,jsx,ts,tsx,json,jsonc}"],
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "performance": {
        "noAccumulatingSpread": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": {
          "level": "error",
          "fix": "safe"
        },
        "noUnusedFunctionParameters": "error",
        "useParseIntRadix": "error"
      },
      "style": {
        "noNestedTernary": "warn",
        "useConsistentCurlyBraces": "error",
        "useTemplate": "error",
        "useSelfClosingElements": "error",
        "useObjectSpread": "error",
        "useAtIndex": "error",
        "useConsistentArrowReturn": "error",
        "useConst": "error",
        "useReactFunctionComponents": "warn",
        "useNumericSeparators": "error"
      }
    }
  },
  "javascript": {
    "globals": ["_"],
    "formatter": {
      "quoteStyle": "single",
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  }
}
